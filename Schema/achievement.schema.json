{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/resume-builder/achievement.schema.json",
  "title": "Achievement",
  "description": "An ordered bullet point attached to an experience.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "experience_id": {
      "type": "integer",
      "minimum": 1
    },
    "order": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
